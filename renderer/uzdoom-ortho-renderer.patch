+			sprite.Process(this, thing, thing->Sector, in_area, false);
+		}
+	};
+
+	auto worldActors = Level->GetThinkerIterator<AActor>();
+	renderProjectiles(worldActors);
+	auto clientActors = Level->GetClientSideThinkerIterator<AActor>();
