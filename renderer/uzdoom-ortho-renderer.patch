 //
 //
 //==========================================================================
+
+static bool WallOccludesOrthoFocus(const HWWall& wall, const HWWallDispatcher* dispatcher)
+{
+	if (!dispatcher || !dispatcher->di) return false;
+
+	const auto& vp = dispatcher->di->Viewpoint;
+	if (!vp.bDoOrtho || !vp.camera || !vp.camera->tracer) return false;
+
+	const auto focus = vp.camera->tracer->Pos();
+	const double rayX = focus.X - vp.Pos.X;
+	const double rayY = focus.Y - vp.Pos.Y;
+	const double wallX = wall.glseg.x2 - wall.glseg.x1;
+	const double wallY = wall.glseg.y2 - wall.glseg.y1;
+	const double denominator = rayX * wallY - rayY * wallX;
+	if (fabs(denominator) < 0.000001) return false;
+
+	const double offsetX = wall.glseg.x1 - vp.Pos.X;
+	const double offsetY = wall.glseg.y1 - vp.Pos.Y;
+	const double rayFraction = (offsetX * wallY - offsetY * wallX) / denominator;
+	const double wallFraction = (offsetX * rayY - offsetY * rayX) / denominator;
+	if (rayFraction <= 0.0 || rayFraction >= 1.0 || wallFraction < 0.0 || wallFraction > 1.0)
+		return false;
+
+	const double rayZ = vp.Pos.Z + rayFraction * (focus.Z - vp.Pos.Z);
+	const double wallBottom = wall.zbottom[0] + wallFraction * (wall.zbottom[1] - wall.zbottom[0]);
+	const double wallTop = wall.ztop[0] + wallFraction * (wall.ztop[1] - wall.ztop[0]);
+	return rayZ >= min(wallBottom, wallTop) - 4.0 && rayZ <= max(wallBottom, wallTop) + 4.0;
+}
