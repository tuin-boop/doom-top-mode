+void HWDrawInfo::RenderOrthoProjectiles()
+{
+	if (!Viewpoint.bDoOrtho) return;
+
+	auto renderProjectiles = [this](auto &iterator)
+	{
+		AActor *thing;
+		while ((thing = iterator.Next()) != nullptr)
+		{
+			if (thing->validcount == validcount) continue;
+
+			const bool isProjectile = (thing->flags & MF_MISSILE) != 0;
+			const bool isDoomTopTracer = thing->GetClass()->IsDescendantOf("DTMFlyingTracer");
